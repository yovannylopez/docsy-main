# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8100
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s

# Entorno de ejecución: development | production
ENVIRONMENT=development

# CORS: orígenes permitidos (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
# Database
# Opción A (producción / PaaS): DATABASE_URL tiene prioridad
# Opción B (local): variables individuales DB_*
# ─────────────────────────────────────────────
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=go_boilerplate
DB_SSLMODE=disable

# Ruta a migraciones (opcional; por defecto se busca ./migrations/core)
# MIGRATIONS_PATH=./migrations/core

# ─────────────────────────────────────────────
# Authentication (JWT)
# ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
TOKEN_EXPIRATION=24h
REFRESH_DURATION=168h
# Bloqueo tras fallos de contraseña (solo login local). 0 = solo contador, sin bloqueo automático.
AUTH_LOCKOUT_MAX_ATTEMPTS=3
AUTH_LOCKOUT_DURATION=15m

# ─────────────────────────────────────────────
# MFA (TOTP) — opcional
# Sin MFA_SECRET_KEY válido (64 hex = 32 bytes AES-256) el módulo MFA queda en modo noop.
# ─────────────────────────────────────────────
# MFA_SECRET_KEY=a3f1b2c4d5e6f7089a1b2c3d4e5f6789012345678901234567890abcdef1234
MFA_ISSUER=docsy-main

# ─────────────────────────────────────────────
# LDAP / Active Directory (opcional)
# ─────────────────────────────────────────────
AUTH_LDAP_ENABLED=false
# AUTH_LDAP_URL=ldap://ldap.example.com:389
# AUTH_LDAP_BASE_DN=dc=example,dc=com
# AUTH_LDAP_BIND_DN=cn=admin,dc=example,dc=com
# AUTH_LDAP_BIND_PASSWORD=ldap-password

# ─────────────────────────────────────────────
# Rate Limiting (Redis — opcional)
# Si REDIS_URL está vacío se usa limitador en memoria
# ─────────────────────────────────────────────
REDIS_URL=
REDIS_AUTH_RATE_LIMIT=60
REDIS_AUTH_RATE_WINDOW_SECS=60

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_OUTPUT=stdout
LOG_FORMAT=json

# ─────────────────────────────────────────────
# Email (opcional)
# ─────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=My App
EMAIL_DOMAIN=example.com

# ─────────────────────────────────────────────
# Storage de archivos (opcional)
# Necesario solo si el proyecto gestiona subida de archivos
# ─────────────────────────────────────────────
DOCUMENT_PATH=./storage/documents
MAX_FILE_SIZE=10485760
