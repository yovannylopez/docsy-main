{{define "partials/alert-success"}}
<div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4 dark:bg-green-950/30 dark:border-green-800">
  <div class="flex gap-3">
    <div class="shrink-0 text-green-600 dark:text-green-400">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </div>
    <div>
      {{if .SuccessTitle}}
      <h3 class="text-sm font-medium text-green-800 dark:text-green-200">{{.SuccessTitle}}</h3>
      {{end}}
      {{if .SuccessMessage}}
      <p class="mt-1 text-sm text-green-700 dark:text-green-300">{{.SuccessMessage}}</p>
      {{end}}
    </div>
  </div>
</div>
{{end}}
