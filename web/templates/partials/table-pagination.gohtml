{{define "partials/table-pagination"}}
<div class="bg-card px-4 py-3 flex items-center justify-between border-t border-border sm:px-6 mt-4 rounded-lg border border-dashed">
  <div class="flex-1 flex justify-between sm:hidden">
    <a
      href="{{.PrevURL}}"
      class="relative inline-flex items-center px-4 py-2 border border-border text-sm font-medium rounded-md text-foreground bg-background hover:bg-muted/40 {{if not .HasPrevious}}pointer-events-none opacity-50{{end}}">
      Anterior
    </a>
    <a
      href="{{.NextURL}}"
      class="ml-3 relative inline-flex items-center px-4 py-2 border border-border text-sm font-medium rounded-md text-foreground bg-background hover:bg-muted/40 {{if not .HasNext}}pointer-events-none opacity-50{{end}}">
      Siguiente
    </a>
  </div>
  <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
    <div>
      <p class="text-sm text-muted-foreground">
        Mostrando <span class="font-medium text-foreground">{{.PageStart}}</span> a
        <span class="font-medium text-foreground">{{.PageEnd}}</span> de
        <span class="font-medium text-foreground">{{.Total}}</span> resultados
      </p>
    </div>
    <div>
      <nav class="relative z-0 inline-flex rounded-md -space-x-px" aria-label="Paginación">
        <a
          href="{{.PrevURL}}"
          class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-border bg-background text-sm font-medium text-muted-foreground hover:bg-muted/40 {{if not .HasPrevious}}pointer-events-none opacity-50{{end}}"
          {{if not .HasPrevious}}aria-disabled="true"{{end}}>
          <span class="sr-only">Anterior</span>
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </a>
        <a
          href="{{.NextURL}}"
          class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-border bg-background text-sm font-medium text-muted-foreground hover:bg-muted/40 {{if not .HasNext}}pointer-events-none opacity-50{{end}}"
          {{if not .HasNext}}aria-disabled="true"{{end}}>
          <span class="sr-only">Siguiente</span>
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </a>
      </nav>
    </div>
  </div>
</div>
{{end}}
