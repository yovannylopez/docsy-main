{{define "partials/archive-docs-table"}}
{{if eq .Mode "folders"}}
  {{if .Folders}}
  <div class="files-grid">
    {{range .Folders}}
    <a href="{{.OpenURL}}" class="folder-card group">
      <span class="folder-type-icon {{.IconTone}}" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75A2.25 2.25 0 016 4.5h3.379a2.25 2.25 0 011.59.659l.872.871c.21.21.495.328.795.328H18A2.25 2.25 0 0120.25 8.25v9A2.25 2.25 0 0118 19.5H6a2.25 2.25 0 01-2.25-2.25v-10.5z" />
        </svg>
      </span>
      <div class="file-card-body">
        <h3 class="file-card-title" title="{{.Label}}">{{.Label}}</h3>
        <p class="file-card-meta">{{.MetaLine}}</p>
      </div>
    </a>
    {{end}}
  </div>
  {{else}}
  <div class="files-empty border-border bg-card rounded-2xl border border-dashed px-4 py-16 text-center">
    <div class="empty-state-icon">{{template "icons/glyph-folder" .}}</div>
    <p class="text-foreground text-base font-semibold">Sin categorías</p>
    <p class="text-muted-foreground mx-auto mt-1 max-w-md text-sm">No hay categorías activas para organizar documentos.</p>
  </div>
  {{end}}
{{else if .Documents}}
  {{if eq .View "list"}}
  <div class="bg-card border-border overflow-hidden rounded-2xl border">
    <div class="overflow-x-auto">
      <table class="divide-border min-w-full divide-y">
        <thead class="bg-muted/30">
          <tr>
            <th class="text-muted-foreground px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Documento</th>
            <th class="text-muted-foreground px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Categoría</th>
            <th class="text-muted-foreground px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Emisor</th>
            <th class="text-muted-foreground px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Fecha</th>
            <th class="text-muted-foreground px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Monto</th>
            <th class="text-muted-foreground px-4 py-3 text-left text-xs font-medium uppercase tracking-wider">Estado</th>
            <th class="text-muted-foreground px-4 py-3 text-right text-xs font-medium uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-border divide-y">
          {{range .Documents}}
          <tr class="hover:bg-muted/20">
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                <span class="file-type-icon file-type-icon-sm {{.IconTone}}" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </span>
                <div class="min-w-0">
                  <div class="flex items-center gap-2 min-w-0">
                    <a href="{{.EditURL}}" class="text-foreground hover:text-primary block truncate text-sm font-semibold">{{.Title}}</a>
                    {{if .HasAttachment}}
                    <span class="file-ext-badge file-ext-badge-inline {{.FileBadgeClass}}" title="Archivo {{.FileExtension}}">{{.FileExtension}}</span>
                    {{end}}
                  </div>
                  {{if .ReferenceNumber}}<div class="text-muted-foreground mt-0.5 text-xs">Ref: {{.ReferenceNumber}}</div>{{end}}
                </div>
              </div>
            </td>
            <td class="px-4 py-3 text-sm whitespace-nowrap">
              <span class="bg-primary/10 text-primary inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium">{{.CategoryLabel}}</span>
            </td>
            <td class="text-foreground px-4 py-3 text-sm">{{if .Issuer}}{{.Issuer}}{{else}}—{{end}}</td>
            <td class="text-foreground px-4 py-3 text-sm whitespace-nowrap">{{if .DocumentDate}}{{.DocumentDate}}{{else}}—{{end}}</td>
            <td class="text-foreground px-4 py-3 text-sm whitespace-nowrap">{{if .AmountDisplay}}{{.AmountDisplay}}{{else}}—{{end}}</td>
            <td class="px-4 py-3 text-sm whitespace-nowrap">
              {{if eq .Status "archived"}}
              <span class="bg-muted text-muted-foreground inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium">Archivado</span>
              {{else}}
              <span class="bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300 inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium">Activo</span>
              {{end}}
            </td>
            <td class="px-4 py-3 text-right">
              <a href="{{.EditURL}}" class="text-primary hover:bg-primary/10 inline-flex rounded-lg p-2 transition-colors" title="Abrir">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            </td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
  </div>
  {{else}}
  <div class="files-grid">
    {{range .Documents}}
    <a href="{{.EditURL}}" class="file-card group">
      {{if eq .Status "archived"}}
      <span class="file-card-badge">Archivado</span>
      {{end}}
      {{if .HasAttachment}}
      <span class="file-ext-badge {{.FileBadgeClass}}" title="Archivo {{.FileExtension}}">{{.FileExtension}}</span>
      {{end}}
      <span class="file-type-icon {{.IconTone}}" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </span>
      <div class="file-card-body">
        <h3 class="file-card-title" title="{{.Title}}">{{.Title}}</h3>
        <p class="file-card-meta">{{.MetaLine}}</p>
        {{if .Issuer}}<p class="file-card-submeta" title="{{.Issuer}}">{{.Issuer}}</p>{{end}}
      </div>
    </a>
    {{end}}
  </div>
  {{end}}
{{template "partials/table-pagination" .Pagination}}
{{else}}
<div class="files-empty border-border bg-card rounded-2xl border border-dashed px-4 py-16 text-center">
  <div class="empty-state-icon">{{template "icons/glyph-folder" .}}</div>
  <p class="text-foreground text-base font-semibold">No hay documentos</p>
  <p class="text-muted-foreground mx-auto mt-1 max-w-md text-sm">
    {{if or .Query .Category}}No se encontraron resultados con esos filtros.{{else}}Empieza registrando una factura, recibo o certificado.{{end}}
  </p>
  {{if not .Query}}
  <a href="{{.CreateURL}}" class="btn btn-primary mt-5 inline-flex rounded-xl px-4 py-2.5 text-sm font-medium">Nuevo documento</a>
  {{end}}
</div>
{{end}}
{{end}}
