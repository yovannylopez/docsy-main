{{define "base-head"}}
<!DOCTYPE html>
<html lang="es" class="{{.ThemeClass}}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{.Title}} — docsy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="{{assetURL "/css/app.css"}}" />
</head>
<body class="bg-background font-poppins text-foreground antialiased">
{{end}}

{{define "base-foot"}}
<script src="{{assetURL "/js/htmx.min.js"}}" defer></script>
<script src="{{assetURL "/js/app.js"}}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof htmx !== 'undefined') {
      // HTMX 2 no intercambia 4xx por defecto; mostrar errores de validación en el formulario.
      htmx.config.responseHandling = [
        {code: '204', swap: false},
        {code: '422', swap: true},
        {code: '[23]..', swap: true},
        {code: '[45]..', swap: false, error: true}
      ];
    }
  });
  document.addEventListener('htmx:configRequest', function(evt) {
    var token = sessionStorage.getItem('access_token');
    if (token) evt.detail.headers['Authorization'] = 'Bearer ' + token;
  });
</script>
</body>
</html>
{{end}}
