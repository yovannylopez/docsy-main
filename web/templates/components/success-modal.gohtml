{{define "components/success-modal"}}
<div
  id="{{.ModalID}}"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="{{.ModalID}}-title">
  <div class="bg-card text-foreground rounded-lg shadow-custom max-w-4xl w-full max-h-[90vh] overflow-hidden flex flex-col border border-border">
    <div class="bg-green-600 text-white px-6 py-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <svg class="h-8 w-8 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <h3 id="{{.ModalID}}-title" class="text-xl font-semibold">{{.Title}}</h3>
      </div>
      <button type="button" onclick="closeModal('{{.ModalID}}')" class="opacity-90 hover:opacity-100 transition-opacity" aria-label="Cerrar">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="px-6 py-6 overflow-y-auto flex-1">
      <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4 dark:bg-green-950/30 dark:border-green-800">
        <div class="flex items-center space-x-2 text-green-800 dark:text-green-200">
          <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="font-medium">{{.Summary}}</span>
        </div>
      </div>

      {{range .Sections}}
      <div class="bg-muted/40 rounded-lg p-4 mb-4 border border-border">
        <h4 class="font-semibold text-foreground mb-3">{{.Title}}</h4>
        <div class="space-y-2 text-sm">
          {{range .Rows}}
          <div class="flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-4">
            <span class="text-muted-foreground">{{.Label}}:</span>
            <span class="font-medium break-words text-foreground">{{.Value}}</span>
          </div>
          {{end}}
        </div>
      </div>
      {{end}}
    </div>

    <div class="flex flex-col sm:flex-row justify-end gap-2 sm:gap-3 p-6 bg-muted/30 border-t border-border">
      <button
        type="button"
        onclick="closeModal('{{.ModalID}}')"
        class="px-6 py-2 text-sm font-medium rounded-lg border border-border bg-background hover:bg-card transition-colors">
        Cerrar
      </button>
      {{if .PrimaryActionURL}}
      <a
        href="{{.PrimaryActionURL}}"
        class="px-6 py-2 text-sm font-medium rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors inline-flex items-center justify-center text-center">
        {{if .PrimaryActionLabel}}{{.PrimaryActionLabel}}{{else}}Continuar{{end}}
      </a>
      {{end}}
    </div>
  </div>
</div>
{{end}}
