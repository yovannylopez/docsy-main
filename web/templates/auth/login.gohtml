{{define "login"}}
{{template "base-head" .}}
<div class="flex h-screen w-screen">
  {{template "auth-left-panel" .}}
  {{template "auth-right-start" .}}

  <form class="my-10 space-y-6" hx-post="/login" hx-target="#login-feedback" hx-swap="innerHTML" id="login-form">
    <div class="text-center">
      <h2 class="text-foreground mb-1 text-3xl font-semibold">{{.Title}}<span class="text-primary">!</span></h2>
      <p class="text-muted-foreground text-sm">{{.Subtitle}}</p>
    </div>

    <div id="login-feedback">
      {{if .Error}}{{template "partials/alerts" .}}{{end}}
    </div>

    <div class="before:border-muted after:border-muted my-4 flex items-center before:mt-0.5 before:flex-1 before:border-t after:mt-0.5 after:flex-1 after:border-t">
      <p class="text-muted-foreground mx-4 mb-0 text-center text-sm">o</p>
    </div>

    <div class="space-y-3 text-left">
      <div class="form__group">
        <div class="relative">
          <input
            type="email"
            id="email"
            name="email"
            value="{{.Email}}"
            class="peer block"
            placeholder=" "
            autocomplete="email"
            required />
          <label
            for="email"
            class="bg-background text-muted-foreground peer-focus:text-primary absolute top-2 z-10 origin-[0] -translate-y-4 scale-95 transform px-2 text-sm duration-300 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:scale-100 peer-focus:top-2 peer-focus:-translate-y-4 peer-focus:scale-95 peer-focus:px-2 ltr:left-1 rtl:right-1">
            Correo electrónico
          </label>
        </div>
      </div>

      <div class="form__group">
        <div class="relative">
          <input
            type="password"
            id="password"
            name="password"
            class="peer block"
            placeholder=" "
            autocomplete="current-password"
            required />
          <label
            for="password"
            class="bg-background text-muted-foreground peer-focus:text-primary absolute top-2 z-10 origin-[0] -translate-y-4 scale-95 transform px-2 text-sm duration-300 peer-placeholder-shown:top-1/2 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:scale-100 peer-focus:top-2 peer-focus:-translate-y-4 peer-focus:scale-95 peer-focus:px-2 ltr:left-1 rtl:right-1">
            Contraseña
          </label>
          <span
            class="text-muted-foreground absolute top-2 cursor-pointer ltr:right-3 rtl:left-3"
            onclick="togglePassword('password', this)"
            role="button"
            tabindex="0"
            aria-label="Mostrar u ocultar contraseña">
            <img src="{{assetURL "/assets/icons/heroicons/outline/eye-off.svg"}}" alt="" class="h-5 w-5 password-toggle-icon" data-visible-icon="{{assetURL "/assets/icons/heroicons/outline/eye.svg"}}" data-hidden-icon="{{assetURL "/assets/icons/heroicons/outline/eye-off.svg"}}" />
          </span>
        </div>
      </div>
    </div>

    <div class="mb-2 flex items-center justify-between space-x-3">
      <div class="flex items-center">
        <input id="remember-me" name="remember_me" type="checkbox" value="1" />
        <label for="remember-me" class="text-muted-foreground ml-2 block text-sm">Recuérdame</label>
      </div>
    </div>

    <div>
      <button
        type="submit"
        class="font-semibold focus-visible:outline-none flex items-center justify-center focus-visible:ring-2 focus-visible:ring-offset-2 active:translate-y-px disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 focus-visible:ring-primary px-5 py-2 text-sm rounded-lg w-full">
        Ingresar
      </button>
    </div>
  </form>

  {{template "auth-right-end" .}}
</div>
{{template "base-foot" .}}
{{end}}
