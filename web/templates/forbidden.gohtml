{{define "forbidden"}}
{{template "base-head" .}}
{{template "app-shell-start" .}}
{{template "partials/form-header" .}}
<div class="bg-card rounded-lg border border-border p-8">
  <p class="text-foreground text-lg">No tienes permiso para acceder a esta sección.</p>
  <p class="text-muted-foreground mt-2 text-sm">Contacta al administrador si necesitas acceso.</p>
  <a href="/" class="btn btn-primary mt-6 inline-flex rounded-md px-4 py-2 text-sm font-medium">Volver al inicio</a>
</div>
{{template "app-shell-end" .}}
{{template "base-foot" .}}
{{end}}
